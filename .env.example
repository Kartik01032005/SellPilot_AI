# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration
MONGO_URI=your_mongodb_connection_string

# Authentication
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# Razorpay Test Mode Credentials (backend only; never commit real values)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# AI Service Configuration (NVIDIA NIM or Gemini)
# NVIDIA NIM Example:
# AI_SERVICE_URL=https://integrate.api.nvidia.com/v1
# AI_API_KEY=your_nvidia_api_key
# AI_MODEL=meta/llama-3.1-70b-instruct
# AI_PROVIDER=nvidia
AI_SERVICE_URL=
AI_API_KEY=
AI_MODEL=meta/llama-3.1-70b-instruct
AI_PROVIDER=

# Frontend Configuration (Public / Safe)
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_NAME=SellPilot AI
