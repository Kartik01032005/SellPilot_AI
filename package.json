{
  "name": "sellpilot-ai-monorepo",
  "version": "1.0.0",
  "description": "SellPilot AI — AI Growth & Agentic Commerce Platform (Razorpay Track 01)",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue.bold,green.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "typecheck:server": "npm --prefix server run typecheck",
    "typecheck:client": "npm --prefix client run typecheck",
    "typecheck": "npm run typecheck:server && npm run typecheck:client",
    "lint:client": "npm --prefix client run lint",
    "test:server": "npm --prefix server run test",
    "test": "npm run test:server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "sellpilot",
    "agentic-commerce",
    "razorpay",
    "ai-growth"
  ],
  "author": "SellPilot Team",
  "license": "ISC"
}
